<!DOCTYPE html>
<html>

<head>

    <title>Student Feedback</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;

            background: linear-gradient(120deg, #74ebd5, #9face6);

            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .feedback-box {
            width: 480px;
            background-color: white;

            padding: 35px;
            border-radius: 18px;

            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        h1 {
            text-align: center;
            color: #333;

            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 25px;
        }

        .field {
            margin-bottom: 20px;
        }

        label {
            display: block;

            font-size: 17px;
            font-weight: bold;

            color: #444;

            margin-bottom: 8px;
        }

        input,
        textarea {
            width: 100%;

            padding: 13px;

            border: 1px solid #ccc;
            border-radius: 8px;

            font-size: 16px;

            outline: none;
        }

        input:focus,
        textarea:focus {
            border-color: #667eea;
        }

        textarea {
            height: 120px;
            resize: vertical;
        }

        button {
            width: 100%;

            padding: 14px;

            background-color: #667eea;
            color: white;

            border: none;
            border-radius: 8px;

            font-size: 17px;
            font-weight: bold;

            cursor: pointer;
        }

        button:hover {
            background-color: #5366d8;
        }

        .error {
            padding: 10px;

            text-align: center;

            color: #d32f2f;
            background-color: #ffe6e6;

            border-radius: 6px;

            font-weight: bold;
        }

        .success {
            padding: 10px;

            text-align: center;

            color: #218838;
            background-color: #e6f7e9;

            border-radius: 6px;

            font-weight: bold;
        }

    </style>

</head>

<body>

    <div class="feedback-box">

        <h1>Student Feedback</h1>

        <p class="subtitle">
            We would love to hear your thoughts!
        </p>


        <% if (error) { %>

            <p class="error">
                <%= error %>
            </p>

        <% } %>


        <% if (message) { %>

            <p class="success">
                <%= message %>
            </p>

        <% } %>


        <form action="/submit" method="POST">

            <div class="field">

                <label for="name">
                    Your Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                >

            </div>


            <div class="field">

                <label for="feedback">
                    Your Feedback
                </label>

                <textarea
                    id="feedback"
                    name="feedback"
                    placeholder="Write your feedback here..."
                ></textarea>

            </div>


            <button type="submit">
                Send Feedback
            </button>

        </form>

    </div>

</body>

</html>
